@model Lebenslauf.Domain.ViewModels.Erfahrung.CreateOrEditErfahrungViewModel
@{
    Layout = null;
    bool isCreate = Model.Id == 0;
}

<form id="ErfahrungForm" asp-area="Admin" asp-controller="Erfahrung" asp-action="SubmitErfahrungFormModal"
      data-ajax="true" data-ajax-begin="StartLoading()" data-ajax-success="ErfahrungFormSubmited">

    <div class="modal-header">
        <h5 class="modal-title">@(isCreate ? "Erstellen" : "Bearbeiten")</h5>
        <button type="button" class="close" data-dismiss="modal">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="modal-body">
        <div class="row">
            <div class="col-12">
                @if (!isCreate)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="form-group">
                    <label asp-for="Title"></label>
                    <div class="controls">
                        <input type="text" asp-for="Title" class="form-control">
                    </div>
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="form-group col-md-6">
                        <label asp-for="StartDate"></label>
                        <div class="controls">
                            <input type="text" asp-for="StartDate" class="form-control" placeholder="z.B. 2018">
                        </div>
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-6">
                        <label asp-for="EndDate"></label>
                        <div class="controls">
                            <input type="text" asp-for="EndDate" class="form-control" placeholder="z.B. 2022">
                        </div>
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Description"></label>
                    <div class="controls">
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Order"></label>
                    <div class="controls">
                        <input type="number" asp-for="Order" class="form-control">
                    </div>
                    <span asp-validation-for="Order" class="text-danger"></span>
                </div>

                <div>
                    <button type="submit" class="btn btn-bold btn-pure float-right @(isCreate ? "btn-success" : "btn-warning")">
                        @(isCreate ? "Erstellen" : "Speichern")
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>