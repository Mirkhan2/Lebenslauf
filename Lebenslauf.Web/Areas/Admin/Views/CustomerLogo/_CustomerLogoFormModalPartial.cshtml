@model Lebenslauf.Domain.ViewModels.CustomerLogo.CreateOrEditCustomerLogoViewModel
@{
    Layout = null;
    bool isCreate = Model.Id == 0;
}

<form id="CustomerLogoForm" asp-area="Admin" asp-controller="CustomerLogo" asp-action="SubmitCustomerLogoFormModal"
      data-ajax="true" data-ajax-begin="StartLoading()" data-ajax-success="CustomerLogoFormSubmited">

    <div class="modal-header">
        <h5 class="modal-title">@(isCreate ? "Erstellen" : "Bearbeiten")</h5>
        <button type="button" class="close" data-dismiss="modal">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="modal-body">
        <div class="row">
            <div class="col-12">
                <input type="hidden" asp-for="Logo" id="HiddenLogo">

                @if (!isCreate)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="form-group">
                    <label asp-for="Link"></label>
                    <div class="controls">
                        <input type="text" asp-for="Link" class="form-control" placeholder="https://www.example.com">
                    </div>
                    <span asp-validation-for="Link" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LogoAlt"></label>
                    <div class="controls">
                        <input type="text" asp-for="LogoAlt" class="form-control" placeholder="SEO Text für Bild">
                    </div>
                    <span asp-validation-for="LogoAlt" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Order"></label>
                    <div class="controls">
                        <input type="number" asp-for="Order" class="form-control">
                    </div>
                    <span asp-validation-for="Order" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="image-upload">Logo hochladen (PNG, JPG, SVG)</label>
                    <div class="controls">
                        <input type="file" id="logo-image-upload" class="form-control" accept=".png,.jpg,.jpeg,.svg" />
                    </div>
                </div>

                <div>
                    <button type="submit" class="btn btn-bold btn-pure float-right @(isCreate ? "btn-success" : "btn-warning")">
                        @(isCreate ? "Erstellen" : "Speichern")
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    $("#logo-image-upload").change(function () {
        const imageFile = this.files[0];
        if (!imageFile) return;

        const ext = imageFile.name.split('.').pop().toLowerCase();

        if (ext === "png" || ext === "jpeg" || ext === "jpg" || ext === "svg") {
            const fd = new FormData();
            fd.append("file", imageFile);

            $.ajax({
                type: "POST",
                url: "/Admin/CustomerLogo/UploadCustomerLogoImageAjax",
                enctype: "multipart/form-data",
                data: fd,
                beforeSend: function () {
                    ShowMessage("Info", "Bitte warten...", "info");
                },
                success: function (response) {
                    if (response.status === "Success") {
                        ShowMessage("Erfolgreich", "Logo wurde erfolgreich hochgeladen.", "success");
                        $("#HiddenLogo").val(response.imageName);
                    } else {
                        ShowMessage("Error", "Ein Fehler ist aufgetreten.", "error");
                    }
                },
                error: function () {
                    ShowMessage("Error", "Serverfehler.", "error");
                },
                cache: false,
                contentType: false,
                processData: false
            });
        } else {
            ShowMessage("Error", "Ungültiges Format.", "error");
        }
    });
</script>