@model Lebenslauf.Domain.ViewModels.Information.CreateOrEditInformationViewModel

@{
    Layout = null; 
    bool isCreate = Model.Id == 0 ? true : false;
}

<form id="InformationForm" asp-area="Admin" asp-controller="Information" asp-action="SubmitInformationFormModal"
      data-ajax="true" data-ajax-begin="StartLoading()" data-ajax-success="InformationFormSubmited">

    <div class="modal-header">
        <h5 class="modal-title">@(isCreate ? "Eröffnen" : "Bearbeitung")</h5>
        <button type="button" class="close" data-dismiss="modal">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="modal-body">
        <div class="row">
            <div class="col-12">

                <input type="hidden" asp-for="Avatar">
                <input type="hidden" asp-for="ResumeFile">

                @if (!isCreate)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="form-group">
                    <label asp-for="Name"></label>
                    <div class="controls">
                        <input type="text" asp-for="Name" class="form-control">
                    </div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Job"></label>
                    <div class="controls">
                        <input type="text" asp-for="Job" class="form-control">
                    </div>
                    <span asp-validation-for="Job" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DateOfBirth"></label>
                    <div class="controls">
                        <input type="text" asp-for="DateOfBirth" class="form-control" placeholder="z.B. 01.01.1990">
                    </div>
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <div class="controls">
                        <input type="text" asp-for="Email" class="form-control">
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Phone"></label>
                    <div class="controls">
                        <input type="text" asp-for="Phone" class="form-control">
                    </div>
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Address"></label>
                    <div class="controls">
                        <textarea asp-for="Address" class="form-control"></textarea>
                    </div>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MapSrc"></label>
                    <div class="controls">
                        <textarea asp-for="MapSrc" class="form-control"></textarea>
                    </div>
                    <span asp-validation-for="MapSrc" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="image-upload">Avatar (JPG, PNG)</label>
                    <div class="controls">
                        <input type="file" name="image-upload" id="image-upload" class="form-control" accept=".jpg, .jpeg, .png" />
                    </div>
                    <span id="avatar-upload-error" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="file-upload">Lebenslauf Datei (Nur PDF)</label>
                    <div class="controls">
                        <input type="file" name="file-upload" id="file-upload" class="form-control" accept=".pdf" />
                    </div>
                    <span id="resume-upload-error" class="text-danger"></span>
                </div>

                <div>
                    <button type="submit" class="btn btn-bold btn-pure float-right btn-warning">Bearbeiten</button>
                </div>

            </div>
        </div>
    </div>
</form>

<script>
    $("#image-upload").change(function () {
        const imageFile = this.files[0];
        if (!imageFile) return;

        const ext = imageFile.name.split('.').pop().toLowerCase();

        if (ext === "png" || ext === "jpeg" || ext === "jpg") {
            const fd = new FormData();
            fd.append("file", imageFile);

            $.ajax({
                type: "POST",
                url: "/Admin/Information/UploadInformationAvatarAjax", 
                enctype: "multipart/form-data",
                data: fd,
                beforeSend: function () {
                    ShowMessage("Info", "Bitte warten Sie, bis der Upload abgeschlossen ist...", "info"); 
                },
                success: function (response) {
                    if (response.status === "Success") {
                        ShowMessage("Erfolgreich", "Avatar wurde erfolgreich hochgeladen.", "success");
                        $("#Avatar").val(response.imageName); 
                    } else {
                        ShowMessage("Error", "Ein Fehler ist aufgetreten.", "error");
                    }
                },
                error: function () {
                    ShowMessage("Error", "Beim Hochladen der Datei ist ein Serverfehler aufgetreten.", "error");
                },
                cache: false,
                contentType: false,
                processData: false
            });
        } else {
            ShowMessage("Error", "Das Dateiformat muss JPG oder PNG sein.", "error");
        }
    });

    $("#file-upload").change(function () {
        const pdfFile = this.files[0];
        if (!pdfFile) return;

        const ext = pdfFile.name.split('.').pop().toLowerCase();

        if (ext === "pdf") {
            const fd = new FormData();
            fd.append("file", pdfFile);

            $.ajax({
                type: "POST",
                url: "/Admin/Information/UploadInformationResumeAjax", 
                enctype: "multipart/form-data",
                data: fd,
                beforeSend: function () {
                    ShowMessage("Info", "Bitte warten Sie, bis der Upload abgeschlossen ist...", "info");
                },
                success: function (response) {
                    if (response.status === "Success") {
                        ShowMessage("Erfolgreich", "Lebenslauf wurde erfolgreich hochgeladen.", "success");
                        $("#ResumeFile").val(response.imageName); 
                    } else {
                        ShowMessage("Error", "Ein Fehler ist aufgetreten.", "error");
                    }
                },
                error: function () {
                    ShowMessage("Error", "Beim Hochladen der Datei ist ein Serverfehler aufgetreten.", "error");
                },
                cache: false,
                contentType: false,
                processData: false
            });
        } else {
            ShowMessage("Error", "Das Dateiformat muss PDF sein.", "error");
        }
    });
</script>