@model Lebenslauf.Domain.ViewModels.Fahigkeit.CreateOrEditFahigkeitViewModel
@{
    Layout = null;
    bool isCreate = Model.Id == 0;
}

<form id="SkillForm" asp-area="Admin" asp-controller="Skill" asp-action="SubmitSkillFormModal"
      data-ajax="true" data-ajax-begin="StartLoading()" data-ajax-success="SkillFormSubmited">

    <div class="modal-header">
        <h5 class="modal-title">@(isCreate ? "Skill Erstellen" : "Skill Bearbeiten")</h5>
        <button type="button" class="close" data-dismiss="modal">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="modal-body">
        <div class="row">
            <div class="col-12">
                @if (!isCreate)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="form-group">
                    <label asp-for="Title">Thema (عنوان مهارت)</label>
                    <div class="controls">
                        <input type="text" asp-for="Title" class="form-control" placeholder="z.B. C# Development">
                    </div>
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Percent">Prozent (درصد تسلط)</label>
                    <div class="controls">
                        <input type="number" asp-for="Percent" class="form-control" min="0" max="100" placeholder="0-100">
                    </div>
                    <span asp-validation-for="Percent" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Order">Priorität (اولویت نمایش)</label>
                    <div class="controls">
                        <input type="number" asp-for="Order" class="form-control">
                    </div>
                    <span asp-validation-for="Order" class="text-danger"></span>
                </div>

                <div class="modal-footer shadow-none px-0 pb-0">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn btn-bold btn-pure @(isCreate ? "btn-success" : "btn-warning")">
                        @(isCreate ? "Hinzufügen" : "Speichern")
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
