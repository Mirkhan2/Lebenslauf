@model Lebenslauf.Domain.ViewModels.CustomerFeedBack.CreateOrEditCustomerFeedbackViewModel
@{
    Layout = null; 
    bool isCreate = Model.Id == 0;
}

<form id="CustomerFeedbackForm" asp-area="Admin" asp-controller="CustomerFeedback" asp-action="SubmitCustomerFeedbackFormModal"
      data-ajax="true" data-ajax-begin="StartLoading()" data-ajax-success="CustomerFeedbackFormSubmited">

    <div class="modal-header">
        <h5 class="modal-title">@(isCreate ? "Erstellen" : "Bearbeiten")</h5>
        <button type="button" class="close" data-dismiss="modal">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="modal-body">
        <div class="row">
            <div class="col-12">

                <input type="hidden" asp-for="Avatar" id="HiddenAvatar">

                @if (!isCreate)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="form-group">
                    <label asp-for="Name"></label>
                    <div class="controls">
                        <input type="text" asp-for="Name" class="form-control">
                    </div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description"></label>
                    <div class="controls">
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Order"></label>
                    <div class="controls">
                        <input type="number" asp-for="Order" class="form-control">
                    </div>
                    <span asp-validation-for="Order" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="image">Avatar hochladen (JPG, PNG)</label>
                    <div class="controls">
                        <input type="file" name="image" id="feedback-image" class="form-control" accept=".png,.jpg,.jpeg" />
                    </div>
                </div>

                <div>
                    <button type="submit" class="btn btn-bold btn-pure float-right @(isCreate ? "btn-success" : "btn-warning")">
                        @(isCreate ? "Erstellen" : "Speichern")
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    $("#feedback-image").change(function () {
        const imageFile = this.files[0];
        if (!imageFile) return;

        const ext = imageFile.name.split('.').pop().toLowerCase();

        if (ext === "png" || ext === "jpeg" || ext === "jpg") {
            const fd = new FormData();
            fd.append("file", imageFile);

            $.ajax({
                type: "POST",
                url: "/Admin/CustomerFeedback/UploadCustomerFeedbackImageAjax",
                enctype: "multipart/form-data",
                data: fd,
                beforeSend: function () { ShowMessage("Info", "Bitte warten...", "info"); },
                success: function (response) {
                    if (response.status === "Success") {
                        ShowMessage("Erfolgreich", "Avatar wurde hochgeladen.", "success");
                        $("#HiddenAvatar").val(response.imageName);
                    } else { ShowMessage("Error", "Ein Fehler ist aufgetreten.", "error"); }
                },
                error: function () { ShowMessage("Error", "Serverfehler.", "error"); },
                cache: false, contentType: false, processData: false
            });
        } else {
            ShowMessage("Error", "Nur JPG oder PNG.", "error");
        }
    });
</script>